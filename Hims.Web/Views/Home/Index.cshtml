@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">

        <section class="hero">
            <div class="hero-content">
                <h1>PAQUETE</h1>
                <h2>FATHER'S DAY</h2>
            </div>
        </section>

        <section class="servicios">
            <h1>SERVICIOS</h1>
            <div class="servicio">
                <img src="/images/corte.jpg" alt="Corte sencillo">
                <h3>Corte sencillo</h3>
                <p>Corte de cabello sencillo.</p>
                <a href="/Home/Cita" class="btn-agendar">Agendar</a>
            </div>
            <div class="servicio">
                <img src="/images/corte.jpg" alt="Corte de pelo y barba">
                <h3>Corte de pelo y barba</h3>
                <p>Servicios completo.</p>
                <a href="/Home/Cita" class="btn-agendar">Agendar</a>
            </div>
            <div class="servicio">
            <img src="/images/corte.jpg" alt="Corte de barba">
                <h3>Corte de barba</h3>
                <p>Corte de barba al gusto.</p>
                <a href="/Home/Cita" class="btn-agendar">Agendar</a>
            </div>
            <div class="servicio">
            <img src="/images/corte.jpg" alt="Corte personalizado">
                <h3>Corte personalizado</h3>
                <p>Corte al gusto.</p>
                <a href="/Home/Cita" class="btn-agendar">Agendar</a>
            </div>
            <div class="servicio">
            <img src="/images/corte.jpg" alt="Limpieza Facial">
                <h3>Limpieza Facial</h3>
                <p>Limpieza profunda para caballero.</p>
                <a href="/Home/Cita" class="btn-agendar">Agendar</a>
            </div>
            <div class="servicio">
            <img src="/images/corte.jpg" alt="Tinte para barba">
                <h3>Tinte para barba</h3>
                <p>Tinte de barba ya sea con decolorante o tinte cubre canas.</p>
                <a href="/Home/Cita" class="btn-agendar">Agendar</a>
            </div>
        </section>

        <section class="nuevas-sucursales">
            <h2>Nuevas Sucursales</h2>
            <button>Descubrir</button>
        </section>

        <section class="nuevos-servicios">
            <h2>Nuevos Servicios</h2>
            <button>Descubrir</button>
        </section>

</div>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Poppins', sans-serif;
    background-color: #f8f8f8;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background-color: #000;
    color: #fff;
}

.header .logo img {
    height: 50px;
}

.nav a {
    margin: 0 15px;
    text-decoration: none;
    color: #fff;
    font-weight: 500;
}

.auth-links a {
    margin: 0 10px;
    color: #fff;
    text-decoration: none;
}

.hero {
    display: flex;
    justify-content: center;
    align-items: center;
    background-image: url('/images/main.jpg'); 
    background-size: cover;
    height: 500px;
    color: white;
    text-align: center;
    }

.hero h1 {
    font-size: 4rem;
    font-weight: 600;
}

.hero h2 {
    font-size: 2.5rem;
    margin-top: 20px;
}

.servicios {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 40px;
}

.servicio {
    background-color: #f8f8f8;
    padding: 20px;
    border-radius: 8px;
    text-align: center;
}

.servicio img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
}

.servicio h3 {
    font-size: 1.5rem;
    margin-top: 10px;
}

.servicio p {
    margin: 10px 0;
}

.servicio button {
    background-color: #6e44ff;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.servicio button:hover {
    background-color: #5833cc;
}

.nuevas-sucursales {
    background-image: url('/images/sucursal.jpg');
    background-size: cover;
    background-position: center;
    padding: 60px 0;
    text-align: center;
    color: white;
}

.nuevos-servicios {
    background-image: url('/images/servicio.jpg');
    background-size: cover;
    background-position: center;
    padding: 60px 0;
    text-align: center;
    color: white;
}

.nuevas-sucursales h2, .nuevos-servicios h2 {
    font-size: 2.5rem;
    margin-bottom: 20px;
}

button {
    background-color: #6e44ff;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

button:hover {
    background-color: #5833cc;
}

footer {
    padding: 20px;
    background-color: #000;
    color: #fff;
    text-align: center;
}

footer .footer-logo img {
    height: 50px;
}

    </style >
