@model Hims.Arquitecture.Models.Branches
@{
    ViewData["Title"] = "Menú de Sucursales";
}

<h1>Menú de Sucursales</h1>

<h4>Sucursales Disponibles</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="SucursalId" class="control-label"></label>
                <input asp-for="SucursalId" class="form-control" placeholder="ID De Sucursal" />
                <span asp-validation-for="SucursalId " class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NombreSucursal" class="control-label"></label>
                <input asp-for="NombreSucursal" class="form-control" placeholder="Nombre de Sucursal" />
                <span asp-validation-for="NombreSucursal" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="HorarioSucursal" class="control-label"></label>
                <input asp-for="HorarioSucursal" class="form-control" placeholder="Horario de Sucursal" />
                <span asp-validation-for="HorarioSucursal" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="UbicacionSucursal" class="control-label"></label>
                <input asp-for="UbicacionSucursal" class="form-control" placeholder="Ubicacion de Sucursal" />
                <span asp-validation-for="UbicacionSucursal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Agregar Sucursal" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Volver al Inicio</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
